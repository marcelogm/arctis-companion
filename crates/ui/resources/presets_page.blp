using Gtk 4.0;
using Adw 1;

template $ArctisPresetsPage: Adw.NavigationPage {
  tag: "presets";
  title: _("Presets");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button new_preset {
        name: "new-preset";
        icon-name: "list-add-symbolic";
        action-name: "win.new-preset";
        tooltip-text: _("New Preset");

        accessibility {
          label: _("New Preset");
        }
      }

      [end]
      Button import {
        name: "import";
        icon-name: "document-open-symbolic";
        tooltip-text: _("Import an Equalizer APO or preset file");

        accessibility {
          label: _("Import an Equalizer APO or preset file");
        }
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup built_in {
        name: "built-in-presets";
        title: _("Built-in");
      }

      Adw.PreferencesGroup custom {
        name: "custom-presets";
        title: _("Custom");
      }
    };
  };
}
