using Gtk 4.0;
using Adw 1;

template $ArctisEqEditorPage: Adw.NavigationPage {
  tag: "eq-editor";
  title: _("Preset");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton menu {
        name: "editor-menu";
        icon-name: "view-more-symbolic";
        menu-model: editor_menu;
        tooltip-text: _("Preset Menu");

        accessibility {
          label: _("Preset Menu");
        }
      }

      [end]
      Button duplicate {
        name: "duplicate";
        icon-name: "edit-copy-symbolic";
        action-name: "editor.duplicate";
        tooltip-text: _("Duplicate Preset");

        accessibility {
          label: _("Duplicate Preset");
        }
      }

      [end]
      ToggleButton preview {
        name: "preview";
        icon-name: "audio-speakers-symbolic";
        tooltip-text: _("Preview Through This Preset");

        accessibility {
          label: _("Preview");
          description: _("Plays through this preset while the page is open");
        }
      }
    }

    content: Adw.BreakpointBin {
      width-request: 360;
      height-request: 200;

      child: Box layout {
        name: "editor-layout";
        orientation: vertical;

        Adw.Clamp {
          maximum-size: 720;
          tightening-threshold: 600;

          child: Box {
            orientation: vertical;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            spacing: 6;

            Box {
              spacing: 12;

              $ArctisEqLegend legend {
                name: "eq-legend";
                hexpand: true;
                valign: center;
              }

              MenuButton {
                name: "reference-menu";
                label: _("Reference");
                always-show-arrow: true;
                menu-model: reference_menu;
                valign: start;
                tooltip-text: _("Curves to Compare");

                styles [
                  "flat",
                ]

                accessibility {
                  label: _("Reference");
                }
              }
            }

            $ArctisEqGraph graph {
              name: "eq-graph";
              height-request: 300;
            }
          };
        }

        ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          child: Adw.Clamp {
            maximum-size: 720;
            tightening-threshold: 600;

            child: Adw.PreferencesGroup bands {
              name: "bands";
              title: _("Bands");
              margin-start: 12;
              margin-end: 12;
              margin-top: 18;
              margin-bottom: 24;

              header-suffix: Button add_band {
                name: "add-band";
                icon-name: "list-add-symbolic";
                action-name: "editor.add-band";
                tooltip-text: _("Add Band");

                styles [
                  "flat",
                ]

                accessibility {
                  label: _("Add Band");
                }
              };
            };
          };
        }
      };

      Adw.Breakpoint {
        condition ("max-height: 640sp")

        setters {
          graph.height-request: 220;
        }
      }

      Adw.Breakpoint {
        condition ("max-height: 440sp")

        setters {
          graph.height-request: 140;
        }
      }
    };
  };
}

menu editor_menu {
  section {
    item {
      label: _("_Rename…");
      action: "editor.rename";
    }

    item {
      label: _("_Export…");
      action: "editor.export";
    }
  }

  section {
    item {
      label: _("_Delete");
      action: "editor.delete";
    }
  }
}

menu reference_menu {
  section {
    item {
      label: _("Headset Response");
      action: "reference.headset";
    }
  }

  section {
    label: _("Target");

    item {
      label: _("None");
      action: "reference.target";
      target: "none";
    }

    item {
      label: _("Harman (B&K 5128)");
      action: "reference.target";
      target: "harman";
    }

    item {
      label: _("Diffuse field (B&K 5128)");
      action: "reference.target";
      target: "diffuse-field";
    }
  }
}
