<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="arctis-companion">
  <enum id="io.github.marcelogm.ArctisCompanion.MuteLight">
    <value nick="off" value="0"/>
    <value nick="low" value="1"/>
    <value nick="medium" value="4"/>
    <value nick="high" value="10"/>
  </enum>
  <enum id="io.github.marcelogm.ArctisCompanion.AutoPowerOff">
    <value nick="never" value="0"/>
    <value nick="1m" value="1"/>
    <value nick="5m" value="5"/>
    <value nick="10m" value="10"/>
    <value nick="15m" value="15"/>
    <value nick="30m" value="30"/>
    <value nick="45m" value="45"/>
    <value nick="60m" value="60"/>
    <value nick="75m" value="75"/>
    <value nick="90m" value="90"/>
  </enum>
  <enum id="io.github.marcelogm.ArctisCompanion.GraphTarget">
    <value nick="none" value="0"/>
    <value nick="harman" value="1"/>
    <value nick="diffuse-field" value="2"/>
  </enum>
  <schema id="io.github.marcelogm.ArctisCompanion" path="/io/github/marcelogm/ArctisCompanion/">
    <key name="mic-volume" type="i">
      <range min="0" max="15"/>
      <default>10</default>
    </key>
    <key name="sidetone" type="i">
      <range min="0" max="10"/>
      <default>0</default>
    </key>
    <key name="mute-light" enum="io.github.marcelogm.ArctisCompanion.MuteLight">
      <default>'medium'</default>
    </key>
    <key name="volume-limiter" type="b">
      <default>true</default>
    </key>
    <key name="extended-range" type="b">
      <default>false</default>
    </key>
    <key name="auto-power-off" enum="io.github.marcelogm.ArctisCompanion.AutoPowerOff">
      <default>'30m'</default>
    </key>
    <key name="preset-dongle" type="s">
      <default>'flat'</default>
    </key>
    <key name="preset-bluetooth" type="s">
      <default>'flat'</default>
    </key>
    <key name="app-rules" type="a{ss}">
      <default>{}</default>
    </key>
    <key name="automatic-presets" type="b">
      <default>true</default>
    </key>
    <key name="adopted-identity" type="s">
      <default>''</default>
    </key>
    <key name="bluetooth-sink-seen" type="b">
      <default>false</default>
    </key>
    <key name="low-battery-threshold" type="i">
      <range min="5" max="50"/>
      <default>15</default>
    </key>
    <key name="run-in-background" type="b">
      <default>true</default>
    </key>
    <key name="background-requested" type="b">
      <default>false</default>
    </key>
    <key name="graph-headset" type="b">
      <default>true</default>
    </key>
    <key name="graph-target" enum="io.github.marcelogm.ArctisCompanion.GraphTarget">
      <default>'harman'</default>
    </key>
  </schema>
</schemalist>
